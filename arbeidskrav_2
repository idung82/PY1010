#Her skulle jeg regne ut omkretsen av en trekant og en halvsirkel. 

import numpy as np
import matplotlib.pyplot as plt

def oppgv5(a, b):
    r = a / 2 # definerer radius
    A = (a * b) / 2 + (np.pi * r**2) / 2 #regner ut areal av trekant + halvsirkel 
    o = b + np.pi * r + np.sqrt(a**2 + b**2) 
    return A, o

side_a = 4
side_b = 6

areal, omkrets = oppgv5(side_a, side_b)
print("Arealet er", areal, "og omkretsen er", omkrets)
